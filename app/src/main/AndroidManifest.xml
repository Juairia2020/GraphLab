<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MS7. INTERNET and ACCESS_NETWORK_STATE are granted at install time. POST_NOTIFICATIONS is a
         runtime permission on Android 13 and newer: the app asks for it only when the user turns on
         the daily reminder, after explaining why (see ui/me/ReminderController). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- MS8. A foreground service must hold FOREGROUND_SERVICE, and from Android 14 also the permission that matches
         its declared type. Both are normal permissions, granted at install time. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- A run that keeps playing after the app is closed, with controls in the notification (PlaybackService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- MS16. The camera is asked for only when the person taps "Take a photo" in the photo import, after explaining why
         (ui/imports/CameraPermission). The camera is optional: a photo can also be chosen from the gallery. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".GraphLabApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GraphLab">

        <!-- Four tabs = four Activities, all extending BaseActivity. Arena is the launcher. -->
        <activity
            android:name=".ui.arena.ArenaActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.lab.LabActivity"
            android:exported="false" />
        <activity
            android:name=".ui.toolkit.MapActivity"
            android:exported="false" />
        <activity
            android:name=".ui.me.MeActivity"
            android:exported="false" />

        <!-- Ordinary screens opened with explicit intents (MS4). Not tabs. -->
        <activity
            android:name=".ui.online.SampleLibraryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.online.GalleryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.me.LifecycleLogActivity"
            android:exported="false"
            android:label="@string/log_title" />
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.arena.QuestionActivity"
            android:exported="false" />

        <!-- MS17: the daily puzzle and its leaderboard. Opened only from the Arena. -->
        <activity
            android:name=".ui.arena.DailyPuzzleActivity"
            android:exported="false" />

        <!-- MS12: the Surprise Engine debug screen (candidate scores and the four weights). -->
        <activity
            android:name=".ui.arena.SurpriseDebugActivity"
            android:exported="false" />

        <!-- MS8: the second component that reads the provider below. -->
        <activity
            android:name=".ui.compare.CompareRunsActivity"
            android:exported="false" />

        <!-- MS7: Firebase Cloud Messaging. Not exported; only the Firebase library may start it. -->
        <service
            android:name=".service.GraphLabMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- MS8: long experiments. Foreground service of type dataSync; not exported, so only this app can start it. -->
        <service
            android:name=".service.ExperimentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- A run that keeps playing in the background, with media controls in the notification. -->
        <service
            android:name=".service.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- MS15: the growth benchmark, a second foreground service of type dataSync. -->
        <service
            android:name=".service.BenchmarkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <activity
            android:name=".ui.lab.DynamicGraphActivity"
            android:exported="false" />
        <activity
            android:name=".ui.lab.BenchmarkActivity"
            android:exported="false" />
        <activity
            android:name=".ui.imports.ImportActivity"
            android:exported="false" />
        <activity
            android:name=".ui.imports.CameraCaptureActivity"
            android:exported="false" />

        <!-- MS8: read-only access to graphs and runs for other components. Not exported: only this app can query it. -->
        <provider
            android:name=".provider.GraphProvider"
            android:authorities="com.graphlab.provider"
            android:exported="false" />

        <!-- Lets other apps read a graph file we are sharing, for a short time only (ACTION_SEND). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

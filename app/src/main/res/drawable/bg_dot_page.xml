<?xml version="1.0" encoding="utf-8"?>
<!-- Page dot: filled with the path colour when it is the current page, outline colour otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="?attr/gl_path" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/gl_outline" />
        </shape>
    </item>
</selector>

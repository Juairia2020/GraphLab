<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape Lab host: no title (height is scarce), same ids as layout/content_lab.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/gap">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/mode_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_graphs"
            style="@style/Widget.GraphLab.ModeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mode_graphs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_build"
            style="@style/Widget.GraphLab.ModeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mode_build" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_run"
            style="@style/Widget.GraphLab.ModeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:text="@string/mode_run" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_compare"
            style="@style/Widget.GraphLab.ModeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mode_compare" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_experiment"
            style="@style/Widget.GraphLab.ModeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="@string/mode_experiment" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/lab_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap_small"
        android:layout_weight="1" />
</LinearLayout>

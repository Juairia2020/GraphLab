<?xml version="1.0" encoding="utf-8"?>
<!-- Image import (MS16): choose a photo, wait, then review and fix what was read. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/gl_bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="@dimen/gap_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/import_back"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="@string/puzzle_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:text="@string/import_title"
            android:textAppearance="@style/TextAppearance.GraphLab.Section" />

        <View
            android:layout_width="@dimen/touch_min"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- 1. choose -->
    <ScrollView
        android:id="@+id/import_source"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:text="@string/import_intro"
                android:textAppearance="@style/TextAppearance.GraphLab.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:text="@string/import_kind_label"
                android:textAppearance="@style/TextAppearance.GraphLab.Label" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/import_kind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                app:checkedButton="@+id/import_kind_drawing"
                app:selectionRequired="true"
                app:singleSelection="true"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/import_kind_drawing"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/import_kind_drawing" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/import_kind_text"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/import_kind_text" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/import_arrows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:minHeight="@dimen/touch_min"
                android:text="@string/import_arrows" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/import_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:minHeight="@dimen/touch_min"
                android:text="@string/import_camera" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/import_gallery"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:minHeight="@dimen/touch_min"
                android:text="@string/import_gallery" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/import_demo"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:minHeight="@dimen/touch_min"
                android:text="@string/import_demo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:text="@string/import_tips"
                android:textAppearance="@style/TextAppearance.GraphLab.Label" />
        </LinearLayout>
    </ScrollView>

    <!-- 2. working -->
    <LinearLayout
        android:id="@+id/import_working"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/import_working_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:text="@string/import_working"
            android:textAppearance="@style/TextAppearance.GraphLab.Body" />
    </LinearLayout>

    <!-- 3. review and fix -->
    <LinearLayout
        android:id="@+id/import_review"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/import_photo"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="@dimen/gap_small"
            android:adjustViewBounds="true"
            android:contentDescription="@string/import_photo_description"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <com.graphlab.ui.imports.ReviewCanvasView
            android:id="@+id/import_canvas"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="@dimen/gap_small"
            android:background="?attr/gl_surface" />

        <TextView
            android:id="@+id/import_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:textAppearance="@style/TextAppearance.GraphLab.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/import_directed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_min"
                android:text="@string/import_directed" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/import_weighted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_small"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_min"
                android:text="@string/import_weighted" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/import_flags"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/import_all_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/gap_small"
            android:text="@string/import_all_clear"
            android:textAppearance="@style/TextAppearance.GraphLab.Label"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/import_add_edge"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_min"
                android:text="@string/import_add_edge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/import_accept_all"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_small"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_min"
                android:text="@string/import_accept_all" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/import_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/gap_small"
            android:minHeight="@dimen/touch_min"
            android:text="@string/import_confirm" />
    </LinearLayout>
</LinearLayout>

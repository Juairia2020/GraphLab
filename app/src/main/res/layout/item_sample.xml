<?xml version="1.0" encoding="utf-8"?>
<!-- One sample graph in the sample library, or one shared graph in the cloud gallery. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_small"
    android:background="?attr/gl_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/gap">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.graphlab.ui.common.ThumbnailView
                android:id="@+id/sample_thumb"
                android:layout_width="84dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_thumb"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sample_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.GraphLab.Section" />

                <TextView
                    android:id="@+id/sample_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.GraphLab.Label" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/sample_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:textAppearance="@style/TextAppearance.GraphLab.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sample_delete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="@string/row_delete"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sample_add"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="@string/samples_add" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

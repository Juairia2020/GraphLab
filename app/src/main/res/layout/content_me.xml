<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_me"
            android:textAppearance="@style/TextAppearance.GraphLab.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:text="@string/appearance"
            android:textAppearance="@style/TextAppearance.GraphLab.Section" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/theme_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/theme_system"
                style="@style/Widget.GraphLab.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/theme_system" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/theme_light"
                style="@style/Widget.GraphLab.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/theme_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/theme_dark"
                style="@style/Widget.GraphLab.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/theme_dark" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:text="@string/appearance_hint"
            android:textAppearance="@style/TextAppearance.GraphLab.Body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:text="@string/about"
            android:textAppearance="@style/TextAppearance.GraphLab.Section" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/about_version"
                        android:textAppearance="@style/TextAppearance.GraphLab.Body" />

                    <TextView
                        android:id="@+id/version_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GraphLab.Label" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/about_engine"
                        android:textAppearance="@style/TextAppearance.GraphLab.Body" />

                    <TextView
                        android:id="@+id/engine_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GraphLab.Label" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:text="@string/me_reminder_title"
            android:textAppearance="@style/TextAppearance.GraphLab.Section" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/me_reminder_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:minHeight="@dimen/touch_min"
            android:text="@string/me_reminder_switch"
            android:textAppearance="@style/TextAppearance.GraphLab.Label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/me_reminder_time"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:minHeight="@dimen/touch_min" />

        <TextView
            android:id="@+id/me_reminder_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:textAppearance="@style/TextAppearance.GraphLab.Body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:text="@string/me_cloud_title"
            android:textAppearance="@style/TextAppearance.GraphLab.Section" />

        <TextView
            android:id="@+id/me_cloud_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:textAppearance="@style/TextAppearance.GraphLab.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/me_cloud_name"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:minHeight="@dimen/touch_min" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/me_cloud_open"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:minHeight="@dimen/touch_min"
            android:text="@string/me_cloud_open" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:text="@string/me_data_title"
            android:textAppearance="@style/TextAppearance.GraphLab.Section" />

        <TextView
            android:id="@+id/me_data_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:textAppearance="@style/TextAppearance.GraphLab.Body" />

        <TextView
            android:id="@+id/me_arena_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:textAppearance="@style/TextAppearance.GraphLab.Body" />

                <com.google.android.material.button.MaterialButton
            android:id="@+id/me_more"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:minHeight="@dimen/touch_min"
            android:text="@string/me_more" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/me_lifecycle_log"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:minHeight="@dimen/touch_min"
            android:text="@string/me_lifecycle_log" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/me_intro"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:minHeight="@dimen/touch_min"
            android:text="@string/me_intro" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/me_arena_reset"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:minHeight="@dimen/touch_min"
            android:text="@string/me_arena_reset" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:text="@string/me_effects"
            android:textAppearance="@style/TextAppearance.GraphLab.Section" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fx_glow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="@string/me_fx_glow" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fx_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="@string/me_fx_sound" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fx_haptics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="@string/me_fx_haptics" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fx_reduce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="@string/me_fx_reduce" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fx_telemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="@string/me_fx_telemetry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/me_test_crash"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:minHeight="@dimen/touch_min"
            android:text="@string/me_test_crash" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_large"
            android:text="@string/state_colours"
            android:textAppearance="@style/TextAppearance.GraphLab.Section" />

        <include
            layout="@layout/include_state_legend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small" />
    </LinearLayout>
</ScrollView>

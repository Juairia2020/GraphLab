<?xml version="1.0" encoding="utf-8"?>
<!-- The one shared shell: content area + the single bottom bar used by all four tabs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/gl_bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/gl_outline" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/gl_surface"
        app:itemIconTint="@color/gl_nav_item"
        app:itemTextColor="@color/gl_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav"
        app:paddingBottomSystemWindowInsets="true" />
</LinearLayout>

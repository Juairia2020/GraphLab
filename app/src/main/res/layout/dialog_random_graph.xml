<?xml version="1.0" encoding="utf-8"?>
<!-- Make a random graph (MS10, Experiment): nodes, density, weight range and a seed. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/random_graph_help"
            android:textAppearance="@style/TextAppearance.GraphLab.Body" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/random_nodes_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:hint="@string/random_nodes_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/random_nodes_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:minHeight="@dimen/touch_min" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/random_density_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:hint="@string/random_density_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/random_density_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:minHeight="@dimen/touch_min" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/random_min_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:hint="@string/random_min_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/random_min_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:minHeight="@dimen/touch_min" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/random_max_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:hint="@string/random_max_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/random_max_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:minHeight="@dimen/touch_min" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/random_seed_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:hint="@string/random_seed_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/random_seed_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:minHeight="@dimen/touch_min" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/random_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:textAppearance="@style/TextAppearance.GraphLab.Label" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- The Lab host (MS3): a title, the mode bar and the fragment for the current mode.
     layout-land/content_lab.xml has the same ids without the title. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="@dimen/screen_padding"
    android:paddingBottom="@dimen/gap">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tab_lab"
        android:textAppearance="@style/TextAppearance.GraphLab.Title" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/mode_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_small"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_graphs"
            style="@style/Widget.GraphLab.ModeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mode_graphs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_build"
            style="@style/Widget.GraphLab.ModeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mode_build" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_run"
            style="@style/Widget.GraphLab.ModeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:text="@string/mode_run" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_compare"
            style="@style/Widget.GraphLab.ModeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mode_compare" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mode_experiment"
            style="@style/Widget.GraphLab.ModeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="@string/mode_experiment" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/lab_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap_small"
        android:layout_weight="1" />
</LinearLayout>

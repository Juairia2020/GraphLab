<?xml version="1.0" encoding="utf-8"?>
<!-- Lab, Run mode. Portrait: the whole screen scrolls, the canvas keeps a fixed height.
     layout-land/fragment_run.xml has the same ids, with the canvas beside a controls column. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/gap">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/run_algorithm"
                android:ellipsize="end"
                android:maxLines="1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:minHeight="@dimen/touch_min" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/run_source"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_small"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_min" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/run_target"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_small"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_min" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/run_go"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_small"
                android:minHeight="@dimen/touch_min"
                android:text="@string/run_go" />
        </LinearLayout>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/run_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/run_export_pdf"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:minHeight="@dimen/touch_min"
            android:text="@string/export_pdf"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/input_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/input_numbers_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="@dimen/touch_min" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/capacity_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/input_capacity_hint"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_capacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLines="1"
                        android:minHeight="@dimen/touch_min" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/input_random"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_small"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/input_random" />
            </LinearLayout>
        </LinearLayout>


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/run_canvas_height"
            android:layout_marginTop="@dimen/gap_small">

            <com.graphlab.ui.common.GraphView
                android:id="@+id/canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.graphlab.ui.common.ArrayView
                android:id="@+id/array_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.graphlab.ui.common.GridView
                android:id="@+id/grid_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/current_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:minLines="2"
            android:textAppearance="@style/TextAppearance.GraphLab.Label" />

        <!-- playback bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_first"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:contentDescription="@string/playback_first"
                android:enabled="false"
                app:icon="@drawable/ic_first"
                app:iconTint="@color/gl_icon_tint" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_prev"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:contentDescription="@string/playback_prev"
                android:enabled="false"
                app:icon="@drawable/ic_prev"
                app:iconTint="@color/gl_icon_tint" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_play"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:contentDescription="@string/playback_play"
                android:enabled="false"
                app:icon="@drawable/ic_play"
                app:iconTint="@color/gl_icon_tint" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:contentDescription="@string/playback_next"
                android:enabled="false"
                app:icon="@drawable/ic_next"
                app:iconTint="@color/gl_icon_tint" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_last"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:contentDescription="@string/playback_last"
                android:enabled="false"
                app:icon="@drawable/ic_last"
                app:iconTint="@color/gl_icon_tint" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.slider.Slider
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/seek_description"
                android:enabled="false"
                android:stepSize="1"
                android:valueFrom="0"
                android:valueTo="1"
                app:labelBehavior="gone"
                app:tickVisible="false" />

            <TextView
                android:id="@+id/step_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="88dp"
                android:gravity="end"
                android:textAppearance="@style/TextAppearance.GraphLab.Label" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speed_title"
                android:textAppearance="@style/TextAppearance.GraphLab.Body" />

            <com.google.android.material.slider.Slider
                android:id="@+id/speed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/speed_description"
                android:enabled="false"
                android:stepSize="0.5"
                android:value="1"
                android:valueFrom="0.5"
                android:valueTo="4"
                app:labelBehavior="gone"
                app:tickVisible="false" />

            <TextView
                android:id="@+id/speed_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:gravity="end"
                android:textAppearance="@style/TextAppearance.GraphLab.Label" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/panel_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_steps"
                style="@style/Widget.GraphLab.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/panel_steps" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_state"
                style="@style/Widget.GraphLab.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/panel_state" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_insight"
                style="@style/Widget.GraphLab.ToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/panel_insight" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/steps_list"
                android:layout_width="match_parent"
                android:layout_height="@dimen/steps_list_height"
                android:contentDescription="@string/steps_list_description"
                android:nestedScrollingEnabled="true" />

            <LinearLayout
                android:id="@+id/state_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/counters_title"
                    android:textAppearance="@style/TextAppearance.GraphLab.Section" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/counters_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/frontier_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_small"
                    android:text="@string/frontier_title"
                    android:textAppearance="@style/TextAppearance.GraphLab.Section" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/frontier_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- MS10: the tables of the running algorithm (queue, stack, priority queue, union-find parents); filled in code. -->
                <LinearLayout
                    android:id="@+id/panels_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_small"
                    android:text="@string/pseudocode_title"
                    android:textAppearance="@style/TextAppearance.GraphLab.Section" />

                <LinearLayout
                    android:id="@+id/pseudocode_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_small"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/values_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    android:textAppearance="@style/TextAppearance.GraphLab.Section" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/node_table"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/insight_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/panel_empty"
                android:layout_width="match_parent"
                android:layout_height="@dimen/steps_list_height"
                android:gravity="center"
                android:text="@string/panel_empty"
                android:textAppearance="@style/TextAppearance.GraphLab.Body" />
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="36dp"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/log_time"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.GraphLab.Label" />

    <TextView
        android:id="@+id/log_source"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.GraphLab.Section" />

    <TextView
        android:id="@+id/log_event"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.GraphLab.Body" />
</LinearLayout>

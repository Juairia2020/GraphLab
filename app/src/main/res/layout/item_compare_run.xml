<?xml version="1.0" encoding="utf-8"?>
<!-- One experiment: graph, date, summary line and its histogram. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_small"
    app:cardBackgroundColor="?attr/gl_surface"
    app:strokeColor="?attr/gl_outline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/compare_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.GraphLab.Section" />

        <TextView
            android:id="@+id/compare_item_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.GraphLab.Label" />

        <TextView
            android:id="@+id/compare_item_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.GraphLab.Body" />

        <com.graphlab.ui.common.HistogramView
            android:id="@+id/compare_item_histogram"
            android:layout_width="match_parent"
            android:layout_height="@dimen/histogram_height_small"
            android:layout_marginTop="@dimen/gap_small" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<!-- One doubtful item on the import review screen (MS16). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/gap_small"
    android:background="?attr/gl_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/gap_small">

    <View
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:background="?attr/gl_frontier" />

    <TextView
        android:id="@+id/flag_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_small"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.GraphLab.Body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/flag_fix"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_min"
        android:text="@string/import_fix" />
</LinearLayout>

rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then press Publish.
//
// Anyone signed in (the app signs in anonymously) can read the gallery. Anyone signed in can
// publish a post that has exactly the expected fields and sizes, as themselves. Only the person who
// published a post can delete it. Nobody can edit a post after it is published.
service cloud.firestore {
  match /databases/{database}/documents {
    match /graphs/{post} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['title', 'author', 'ownerUid', 'nodes', 'edges', 'createdAt', 'json'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 40
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.author.size() <= 24
        && request.resource.data.json is string
        && request.resource.data.json.size() <= 100000
        && request.resource.data.nodes is number
        && request.resource.data.edges is number
        && request.resource.data.createdAt is number;

      allow update: if false;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Player progress (MS12): one document per signed-in user, private to that user.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['progress', 'mastery', 'updatedAt'])
        && request.resource.data.progress is string
        && request.resource.data.progress.size() <= 5000
        && request.resource.data.mastery is string
        && request.resource.data.mastery.size() <= 5000
        && request.resource.data.updatedAt is number;
      allow delete: if false;
    }

    // Daily puzzle leaderboard (MS17): one result per player per day. Anyone signed in can read. A player can create only
    // their own result, once (no update, no delete), with sensible values. A phone can still send a made-up score within
    // these limits; the rules bound the damage but cannot prove a score was earned.
    match /daily/{date}/scores/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['name', 'score', 'correct', 'seconds', 'submittedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 600
        && request.resource.data.correct is number
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= 5
        && request.resource.data.seconds is number
        && request.resource.data.seconds >= 0
        && request.resource.data.seconds <= 3600
        && request.resource.data.submittedAt is number;
      allow update, delete: if false;
    }
  }
}
